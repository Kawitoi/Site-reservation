# PostgreSQL connection string used by Prisma.
DATABASE_URL=

# Better Auth. Generate a strong secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=

# SMTP / transactional email provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Stripe (leave empty in local dev to disable billing gating).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
